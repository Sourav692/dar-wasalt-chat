# Copy to .env for local runs. Never commit .env.
OPENROUTER_API_KEY=sk-or-REPLACE_ME
# Comma-separated: primary first, then fallbacks. Set after the Phase 8 bake-off.
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free
# Optional. When set, clients must send header X-Access-Code with this value.
ACCESS_PASSCODE=
