# Copy to .env for local runs. Never commit .env.
OPENROUTER_API_KEY=sk-or-REPLACE_ME
# Comma-separated: primary first, then fallbacks. Set after the Phase 8 bake-off.
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free
# Optional. When set, clients must send header X-Access-Code with this value.
# At least 20 characters, random: python -c 'import secrets; print(secrets.token_urlsafe(24))'
ACCESS_PASSCODE=
# Per-client limits (in-memory, per instance).
RATE_PER_MINUTE=10
RATE_PER_DAY=100
# Proxies that append to X-Forwarded-For. 1 on Cloud Run; 0 to ignore the header.
TRUSTED_PROXY_HOPS=1
# Salt for hashing client IPs in logs. Unset: random per process.
LOG_SALT=
